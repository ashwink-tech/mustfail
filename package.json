{
  "name": "mustfail",
  "version": "0.1.0-alpha.42",
  "description": "Finds Playwright tests that stay green when the app is broken. No changes to your tests.",
  "license": "MIT",
  "author": "Ashwin (https://github.com/ashwink-tech)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashwink-tech/mustfail.git"
  },
  "bugs": {
    "url": "https://github.com/ashwink-tech/mustfail/issues"
  },
  "homepage": "https://github.com/ashwink-tech/mustfail#readme",
  "bin": {
    "mustfail": "bin/mustfail.js"
  },
  "files": [
    "bin",
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50"
  },
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "test-quality",
    "fault-injection",
    "mutation-testing",
    "flaky-tests",
    "test-strength"
  ],
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/run-unit.js",
    "test:e2e": "node test/e2e.js",
    "test:all": "node test/run-unit.js && node test/e2e.js"
  }
}
